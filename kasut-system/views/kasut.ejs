<!DOCTYPE html>
<html lang="ms">
<%- include('partials/head') %>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar') %>
    <main class="main">
      <div class="page-header">
        <div>
          <h1>Jenis Kasut</h1>
          <p>Urus brand, harga, saiz dan stok kasut</p>
        </div>
      </div>

      <%- include('partials/flash') %>

      <div class="panel">
        <h2>Tambah Jenis Kasut Baharu</h2>
        <form action="/kasut" method="POST" class="form-grid">
          <div>
            <label>Brand</label>
            <input type="text" name="brand" placeholder="cth: Nike" required />
          </div>
          <div>
            <label>Model</label>
            <input type="text" name="model" placeholder="cth: Air Max 270" />
          </div>
          <div>
            <label>Saiz</label>
            <input type="text" name="saiz" placeholder="cth: 9" required />
          </div>
          <div>
            <label>Harga (RM)</label>
            <input type="number" step="0.01" name="harga" placeholder="199.00" required />
          </div>
          <div>
            <label>Stok</label>
            <input type="number" name="stok" placeholder="20" value="0" />
          </div>
          <div>
            <label>Vendor</label>
            <select name="vendor_id">
              <option value="">- Pilih Vendor -</option>
              <% vendors.forEach(v => { %>
                <option value="<%= v.id %>"><%= v.nama_vendor %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <button type="submit" class="btn">+ Tambah Kasut</button>
          </div>
        </form>
      </div>

      <div class="panel">
        <h2>Senarai Kasut (<%= kasut.length %>)</h2>
        <table>
          <thead>
            <tr><th>#</th><th>Brand</th><th>Model</th><th>Saiz</th><th>Harga</th><th>Stok</th><th>Vendor</th><th>Tindakan</th></tr>
          </thead>
          <tbody>
            <% if (kasut.length === 0) { %>
              <tr><td colspan="8" style="text-align:center;color:var(--grey);padding:20px;">Tiada kasut lagi.</td></tr>
            <% } %>
            <% kasut.forEach(k => { %>
              <tr>
                <td>#<%= k.id %></td>
                <td><%= k.brand %></td>
                <td><%= k.model || '-' %></td>
                <td><%= k.saiz %></td>
                <td>RM<%= k.harga.toFixed(2) %></td>
                <td>
                  <span class="badge <%= k.stok <= 5 ? 'low' : '' %>"><%= k.stok %> unit</span>
                </td>
                <td><%= k.nama_vendor || '-' %></td>
                <td class="actions">
                  <form action="/kasut/<%= k.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Padam kasut ini?');">
                    <button type="submit" class="btn danger">Padam</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</body>
</html>
