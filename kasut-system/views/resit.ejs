<!DOCTYPE html>
<html lang="ms">
<%- include('partials/head') %>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar') %>
    <main class="main">
      <div class="resit-card">
        <div class="header">
          <div class="check">✓</div>
          <h1 style="font-family:var(--font-display);color:var(--navy);margin:0;">Pembayaran Berjaya</h1>
          <p style="color:var(--grey);margin:4px 0 0;">Resit #<%= String(resit.id).padStart(5,'0') %></p>
        </div>

        <div class="resit-row"><span>Customer</span><strong><%= resit.nama_customer %></strong></div>
        <div class="resit-row"><span>No. Telefon</span><span><%= resit.no_telefon || '-' %></span></div>
        <div class="resit-row"><span>Kasut</span><span><%= resit.brand %> <%= resit.model %> (Saiz <%= resit.saiz %>)</span></div>
        <div class="resit-row"><span>Kuantiti</span><span><%= resit.kuantiti %></span></div>
        <div class="resit-row"><span>Harga Seunit</span><span>RM<%= resit.harga_seunit.toFixed(2) %></span></div>
        <div class="resit-row"><span>Kaedah Bayaran</span><span><%= resit.kaedah_bayaran %></span></div>
        <div class="resit-row"><span>Diproses Oleh</span><span><%= resit.nama_staff %></span></div>
        <div class="resit-row"><span>Tarikh</span><span><%= new Date(resit.tarikh).toLocaleString('ms-MY') %></span></div>
        <div class="resit-row total"><span>Jumlah Bayaran</span><span>RM<%= resit.jumlah.toFixed(2) %></span></div>

        <div class="resit-actions">
          <a href="/pembelian" class="btn secondary" style="flex:1;text-align:center;">Kembali</a>
          <button onclick="window.print()" class="btn" style="flex:1;">🖨️ Cetak</button>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
